{
  "name": "mynote-monorepo",
  "private": true,
  "description": "Block-based notes on plain Markdown + git, open to AI agents over MCP",
  "license": "MIT",
  "homepage": "https://github.com/likeca/MyNote",
  "repository": {
    "type": "git",
    "url": "https://github.com/likeca/MyNote.git"
  },
  "bugs": {
    "url": "https://github.com/likeca/MyNote/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "plugins/*"
  ],
  "scripts": {
    "app": "npm run app -w @mynote/desktop",
    "build:app": "npm run mcp:build && npm run build:app -w @mynote/desktop",
    "lander": "npm run dev -w @mynote/lander",
    "mcp:build": "npm run build -w mynote-mcp",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "version:set": "node scripts/set-version.mjs",
    "plugins": "node scripts/plugins.mjs"
  }
}
